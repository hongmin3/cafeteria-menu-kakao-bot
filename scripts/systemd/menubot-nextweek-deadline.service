# 뷰밥 메뉴 알리미 — 주말 폴링 마감 점검(미확보면 알림 메일)
[Unit]
Description=Vieworks menu bot next-week deadline check (뷰밥 다음 주 미확보 알림)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=__APP_DIR__
Environment=TZ=Asia/Seoul
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1
ExecStart=__APP_DIR__/scripts/run-linux-next-week-deadline.sh
# 마감 직전에 마지막 수집 시도를 한 번 하므로(run-linux-next-week-deadline.sh
# 주석 참고) 수집 유닛과 같은 상한이 필요하다.
MemoryHigh=3G
MemoryMax=4G
TimeoutStartSec=1800
