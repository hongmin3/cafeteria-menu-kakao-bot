# 일요일 22:00 (한국시간). 금요일 18시부터 매시 돌린 확인이 주말을 다 쓰고도
# 다음 주 식단을 확보하지 못했다면, 이 시점에 사람이 알아야 한다.
#
# 이것은 마감 알림이지 수집의 끝이 아니다. 23:00부터 menubot-ensure.timer가
# 매시 이어받아 식단표를 읽어 낼 때까지 계속 시도하고, 읽어 내면 수집 완료
# 메일이 나간다. 미확보 알림은 주차당 한 번만 보낸다.
[Unit]
Description=Vieworks menu bot next-week deadline timer (일 22:00 KST)

[Timer]
OnCalendar=Sun 22:00 Asia/Seoul
Persistent=true
Unit=menubot-nextweek-deadline.service

[Install]
WantedBy=timers.target
