GROUPWARE_USER=사원번호
GROUPWARE_PASSWORD=비밀번호
GROUPWARE_URL=https://groupware.example.com/path/to/board
POST_PREFIXES=뷰웍스,안양,화성,평촌
# 비워두면 여러 사업장 메뉴가 있을 때 사용자에게 다시 묻습니다.
DEFAULT_LOCATION=
DATABASE_PATH=data/menus.db
TIMEZONE=Asia/Seoul
# 공개 배포 시 임의의 긴 문자열을 넣고 /kakao/skill/<토큰> URL을 등록하세요.
KAKAO_WEBHOOK_TOKEN=
# ngrok 무료 계정에서 발급되는 고정 개발 도메인(https:// 제외)
NGROK_DOMAIN=
# OCR 엔진: auto(기본, macOS는 Apple Vision·그 외는 PaddleOCR) | apple_vision | paddleocr
OCR_PROVIDER=auto
# 다음 주 게시글 확인 폴링 상태 저장 위치(기본값 그대로 사용 권장)
NEXT_WEEK_STATE_PATH=data/next_week_watch_state.json
# Linux 서버에서 FastAPI가 바인딩할 로컬 포트(127.0.0.1만 바인딩).
# 다른 서비스와 함께 쓰는 서버라면 배포 전에 `ss -tlnp`로 사용 중인 포트를
# 확인하고 겹치지 않는 값을 골라야 한다.
MENUBOT_PORT=18080
# PaddleOCR 모델 조합. 장비에 따라 되는 조합이 달라 비워두면 Windows에서
# 검증된 기본값(PP-OCRv5_mobile_det + korean_PP-OCRv5_mobile_rec, mkldnn off)을 쓴다.
#PADDLE_DET_MODEL=PP-OCRv5_server_det
#PADDLE_REC_MODEL=korean_PP-OCRv5_mobile_rec
#PADDLE_ENABLE_MKLDNN=0
# Playwright 브라우저 채널. auto는 macOS/Windows에서 chrome, Linux에서
# Playwright 번들 Chromium을 쓴다.
BROWSER_CHANNEL=auto
