GROUPWARE_USER=사원번호
GROUPWARE_PASSWORD=비밀번호
GROUPWARE_URL=https://groupware.example.com/path/to/board
POST_PREFIXES=뷰웍스,안양,화성,평촌
# 비워두면 여러 사업장 메뉴가 있을 때 사용자에게 다시 묻습니다.
DEFAULT_LOCATION=
DATABASE_PATH=data/menus.db
TIMEZONE=Asia/Seoul
# 공개 배포 시 임의의 긴 문자열을 넣고 /kakao/skill/<토큰> URL을 등록하세요.
KAKAO_WEBHOOK_TOKEN=
# ngrok 무료 계정에서 발급되는 고정 개발 도메인(https:// 제외)
NGROK_DOMAIN=
# OCR 엔진: auto(기본, macOS는 Apple Vision·그 외는 PaddleOCR) | apple_vision | paddleocr
OCR_PROVIDER=auto
# 다음 주 게시글 확인 폴링 상태 저장 위치(기본값 그대로 사용 권장)
NEXT_WEEK_STATE_PATH=data/next_week_watch_state.json
